
void setup(){
  size(400,500);
}
void draw(){
  noStroke();
ellipse(200,250,200,200);
ellipse (200,180,150,170);
stroke(0,0,0);
ellipse(200,90,90,65);
ellipse(190,300,75,130);
fill(0,0,0);
ellipse(180,90,13,13);
ellipse(220,90,13,13);
line(180,90,220,90);
fill(250,250,250);
rotate(PI/7);
ellipse(170,150,75,200);
rotate(7*PI/4);
ellipse(220,300,75,200);
}

